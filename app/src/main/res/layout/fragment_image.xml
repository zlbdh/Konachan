<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ess.anime.wallpaper.ui.view.MySwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/layout_multiple_media" />
    </com.ess.anime.wallpaper.ui.view.MySwipeRefreshLayout>

    <View
        android:id="@+id/view_touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Multi-page gallery navigation (e.g. nhentai); hidden for single-image sites -->
    <LinearLayout
        android:id="@+id/layout_page_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_page_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.9"
            android:padding="4dp"
            android:src="@drawable/ic_image_previous" />

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="1/1"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/iv_page_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.9"
            android:padding="4dp"
            android:src="@drawable/ic_image_next" />
    </LinearLayout>
</FrameLayout>
